# 复制为 .env 后填写。.env 已被 .gitignore 排除，切勿提交。

# ---- 号池网关（codex-lb）----
# 管理面地址，用于签发/吊销密钥、拉取用量
POOL_ADMIN_URL=https://pool.chekkk.com
# 管理面密码。codex-lb dashboard 目前用 cookie session 登录管理面。
POOL_ADMIN_PASSWORD=
# 管理面令牌预留。当前 codex-lb 管理面不接受 Bearer。
POOL_ADMIN_TOKEN=

# 员工侧 codex 实际访问的网关地址。
# 必须是 daemon 宿主机可达的地址；CHEK 正式环境默认走 prod 域名。
POOL_BASE_URL=https://codex.chekkk.com/v1

# ---- multica ----
# 云端为 https://api.multica.ai；自托管填自己的地址
MULTICA_SERVER_URL=https://api.multica.ai
# 个人访问令牌（mul_ 开头），用于调 /api/agents/{id}/env 下发密钥
MULTICA_TOKEN=

# ---- 注入行为 ----
# 写入 codex 配置时使用的 provider id，会出现在 [model_providers.<id>]
POOL_PROVIDER_ID=gw
# 环境变量名，codex 从此变量读取密钥。名称须与注入的 env_key 一致
POOL_ENV_KEY=GW_API_KEY
